{
  "version": "2.0",
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  },
  "logging": {
    "logLevel": {
      "default": "Trace",
      "Host": "Trace",
      "Host.Results": "Trace",
      "Function": "Trace",
      "Worker": "Trace",
      "Microsoft": "Debug"
    },
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": false
      }
    }
  }
}