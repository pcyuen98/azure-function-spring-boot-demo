{
  "version": "2.0",
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  },
  "functionTimeout": "00:10:00",
  "logging": {
    "LogLevel": {
      "Default": "Trace",
      "Host": "Trace",
      "Function": "Trace",
      "Microsoft": "Trace",
      "Worker": "Trace"
    },
    "applicationInsights": {
      "LogLevel": {
        "Default": "Trace"
      }
    },
    "samplingSettings": {
      "isEnabled": false
    }
  }
}
